[Unit]
Description=Gander file previewer (Space in Nautilus)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.gnome.NautilusPreviewer
ExecStart=/usr/bin/gander daemon
Restart=on-failure
RestartSec=1
# Apps opened from the preview run in scopes of their own; this keeps any
# stragglers alive across a restart.
KillMode=process

[Install]
WantedBy=graphical-session.target
